# Copy to .env and fill in from Supabase → Project Settings → API.
# The anon key is public by design; row-level security is the protection layer.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed for scripts/import-legacy.ts (run once, locally):
# your account's email + password to sign in and copy the legacy blob.
LEGACY_IMPORT_EMAIL=
LEGACY_IMPORT_PASSWORD=
